{
  "compilerOptions": {
    "allowJs": false,
    "lib": ["ES2024", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["./worker-configuration.d.ts", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
