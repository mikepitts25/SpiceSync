{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spicesync-account-deletion-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "UPSTREAM_URL": "https://gewxwyvjcdplbdkygnib.supabase.co/functions/v1/spicesync-account-deletion"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "DeletionRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeletionRateLimiter"]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "SECURITY_EVENTS",
      "dataset": "spicesync_account_deletion_gateway"
    }
  ]
}
