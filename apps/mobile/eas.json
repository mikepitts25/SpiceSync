{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PURCHASES_ENABLED": "false",
        "EXPO_PUBLIC_FREE_BETA_ACCESS": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6802104241"
      }
    }
  }
}
